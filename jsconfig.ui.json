{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/categoryDefinitions.jsx",
    "src/components/AppFooter.jsx",
    "src/components/AppHeader.jsx",
    "src/components/DesktopCategoryNav.jsx",
    "src/components/LanguageSwitcher.jsx",
    "src/components/MobileDrawer.jsx",
    "src/components/AudioMeta/lib/**/*.js",
    "src/components/VideoMeta/lib/**/*.js",
    "src/hooks/useAppRouting.js",
    "src/hooks/useDocumentTitle.js",
    "src/hooks/useShellPersistence.js",
    "src/i18n/**/*.js",
    "src/toolModes.js",
    "src/toolRouteMetadata.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/tests"
  ]
}
