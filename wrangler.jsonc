{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "small-web-tools",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "pages_build_output_dir": "./dist",
  "services": [
    {
      "binding": "RATE_LIMITER_SERVICE",
      "service": "small-web-tools-rate-limiter"
    }
  ],
  "vars": {
    "RATE_LIMIT_DEVELOPMENT_MODE": "false",
    "FONT_EXTRACTION_EGRESS_POSTURE": "compatibility-date=2026-07-23;flags=global_fetch_strictly_public;fetch-implementation=safe-external-fetch-v2"
  }
}
